# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
SESSION_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:3000

# ── Gmail OAuth (Google Cloud Console → APIs & Services → Credentials) ────────
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:3001/auth/gmail/callback

# ── Gemini (aistudio.google.com → Get API key) ───────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional: Plaid (for open banking verification layer — v2) ────────────────
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
